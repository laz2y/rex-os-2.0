{
  "name": "REX OS — Control Center",
  "short_name": "REX OS",
  "description": "REX OS — your self-hosted NAS control center for media, containers, cloud and photos.",
  "id": "/",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#0b0d12",
